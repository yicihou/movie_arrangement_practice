package cinema.sys.starter;

import cinema.sys.action.UserAction;
import cinema.sys.menu.Menu;
import cinema.sys.menu.MenuMannager;
import cinema.sys.util.InputUtil;

import java.util.List;
import java.util.Map;

public class CinemaClient {
    public static void main(String[] args) {
        InterfaceMenu(MenuMannager.Login_Menu);
    }

    public static void InterfaceMenu(Menu[] menus){
        //调用展示菜单
        MenuMannager.showMenus(menus);
        //选择
        int number=InputUtil.inputjudge("请选择菜单编号：",1,menus.length);//调用工具类
        Menu select=menus[number-1];
        //根据选择分发
        switch (select.getAction()){
            case"register":
                UserAction.register();
                break;
            case "login":
                Map<String,Object> result=UserAction.login();
                //判断非空/空
                if(result==null){//空
                    System.out.println("账号或密码错误，请稍后重试");
                    MenuMannager.showMenus(MenuMannager.Login_Menu);
                }else {//非空
                    //获取process
                    int process = (int) result.get("process");
                    //判断返回值
                    if(process==1){
                        //判断是否为管理员
                        boolean isManager= (boolean) result.get("manager");
                        if(isManager){
                            MenuMannager.showMenus(MenuMannager.mannger_Menu);
                        }else {
                            MenuMannager.showMenus(MenuMannager.user_Menu);
                        }
                    }else if(process==0){
                        System.out.println("账号或密码错误，请稍后重试");
                    }else if(process==-1){
                        System.out.println("账号不存在，请先行注册账号后再登陆");
                    }else if(process==-2){
                        System.out.println("账号已被冻结，请申请解冻后重试");
                    }
                }
                break;
            case"showchildren":
                List<Menu>children=select.getChildren();
                Menu[] childrenMenus=children.toArray(new Menu[0]);
                InterfaceMenu(childrenMenus);
                return;//子菜单内部自己会继续，无需再回一层
            case"exit":
                UserAction.exit();
                break;
            default:
                //其他叶子动作（login/find/apply...）在此扩展
                break;
        }
        //叶子动作执行完后，回到父菜单；无父菜单则回登录菜单
        Menu parent=select.getParent();//获取父菜单
        Menu[] parentsMenusList=(parent==null)
                ? MenuMannager.Login_Menu
                : parent.getChildren().toArray(new Menu[0]);
        InterfaceMenu(parentsMenusList);
    }
}
